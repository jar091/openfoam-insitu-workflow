		<socket name="object_space" value="true" type_name="boolean" />
		<socket name="step_size" value="0.0" type_name="float" />
		<attribute name="Q" std="ATTR_STD_NONE" type="float" element="ATTR_ELEMENT_VOXEL" flags="0" buffer="/scratch/project/eu-25-121/milanjaros/openfoam/runs/pitzDaily3D/62M/VDB_v2/pitz_195600.vdb" volume_type="openvdb" />
