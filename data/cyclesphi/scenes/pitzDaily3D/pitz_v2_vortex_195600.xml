		<connect from_node="bg_light" from_socket="background" to_node="bg_mix" to_socket="closure1" />
		<connect from_node="bg_camera" from_socket="background" to_node="bg_mix" to_socket="closure2" />
		<connect from_node="bg_mix" from_socket="closure" to_node="output" to_socket="surface" />
	</shader>
	<shader name="default_empty" />

	<shader name="vol_shader">
		<attribute name="v_attr_Q"><socket name="attribute" value="Q" type_name="string" /></attribute>
		<attribute name="v_attr_U"><socket name="attribute" value="U_mag" type_name="string" /></attribute>
		<map_range name="v_mr_Q">
			<socket name="from_min" value="300000.0" type_name="float" />
			<socket name="from_max" value="12000000.0" type_name="float" />
			<socket name="clamp" value="true" type_name="boolean" />
		</map_range>
		<map_range name="v_mr_U">
			<socket name="from_min" value="2.0" type_name="float" />
			<socket name="from_max" value="28.0" type_name="float" />
			<socket name="clamp" value="true" type_name="boolean" />
		</map_range>
		<rgb_ramp name="v_ramp_Q">
			<socket name="ramp" value="5156" type_name="array_color" />
			<socket name="ramp_alpha" value="9276" type_name="array_float" />
		</rgb_ramp>
		<rgb_ramp name="v_ramp_U">
			<socket name="ramp" value="5156" type_name="array_color" />
			<socket name="ramp_alpha" value="9276" type_name="array_float" />
		</rgb_ramp>
		<math name="v_dens"><socket name="math_type" value="multiply" type_name="enum" />
			<socket name="value2" value="400.0" type_name="float" /></math>
		<math name="v_emis"><socket name="math_type" value="multiply" type_name="enum" />
			<socket name="value2" value="5.0" type_name="float" /></math>
		<principled_volume name="v_pv">
			<socket name="anisotropy" value="0.3" type_name="float" />
		</principled_volume>
		<connect from_node="v_attr_Q" from_socket="fac" to_node="v_mr_Q" to_socket="value" />
		<connect from_node="v_attr_U" from_socket="fac" to_node="v_mr_U" to_socket="value" />
		<connect from_node="v_mr_Q" from_socket="result" to_node="v_ramp_Q" to_socket="fac" />
		<connect from_node="v_mr_U" from_socket="result" to_node="v_ramp_U" to_socket="fac" />
		<connect from_node="v_ramp_Q" from_socket="alpha" to_node="v_dens" to_socket="value1" />
		<connect from_node="v_ramp_Q" from_socket="alpha" to_node="v_emis" to_socket="value1" />
		<connect from_node="v_ramp_U" from_socket="color" to_node="v_pv" to_socket="color" />
		<connect from_node="v_ramp_U" from_socket="color" to_node="v_pv" to_socket="emission_color" />
		<connect from_node="v_dens" from_socket="value" to_node="v_pv" to_socket="density" />
		<connect from_node="v_emis" from_socket="value" to_node="v_pv" to_socket="emission_strength" />
		<connect from_node="v_pv" from_socket="volume" to_node="output" to_socket="volume" />
	</shader>

