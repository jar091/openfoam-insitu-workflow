<?xml version="1.0"?>
<!-- DLRCJH combustor, look=flame (data/cyclesphi/scenes/DLRCJH/make_dlrcjh_scene.py) -->
<cycles>
	<shader name="default_surface" />
	<shader name="default_volume" />
	<shader name="default_light" />
	<shader name="default_background">
		<background_shader name="bg_light">
			<socket name="color" value="0.03 0.035 0.045 0" type_name="color" />
			<socket name="strength" value="1" type_name="float" />
		</background_shader>
		<texture_coordinate name="bg_tc" />
		<separate_xyz name="bg_sep" />
		<map_range name="bg_mr">
			<socket name="from_min" value="-0.5" type_name="float" />
			<socket name="from_max" value="0.45" type_name="float" />
			<socket name="clamp" value="true" type_name="boolean" />
		</map_range>
		<mix_color name="bg_grad">
			<socket name="a" value="0.001 0.001 0.002 0" type_name="color" />
			<socket name="b" value="0.016 0.019 0.03 0" type_name="color" />
		</mix_color>
		<background_shader name="bg_camera">
			<socket name="strength" value="1" type_name="float" />
		</background_shader>
		<light_path name="bg_lightpath" />
		<mix_closure name="bg_mix" />
		<connect from_node="bg_tc" from_socket="generated" to_node="bg_sep" to_socket="vector" />
		<connect from_node="bg_sep" from_socket="y" to_node="bg_mr" to_socket="value" />
		<connect from_node="bg_mr" from_socket="result" to_node="bg_grad" to_socket="fac" />
		<connect from_node="bg_grad" from_socket="result" to_node="bg_camera" to_socket="color" />
		<connect from_node="bg_lightpath" from_socket="is_camera_ray" to_node="bg_mix" to_socket="fac" />
		<connect from_node="bg_light" from_socket="background" to_node="bg_mix" to_socket="closure1" />
		<connect from_node="bg_camera" from_socket="background" to_node="bg_mix" to_socket="closure2" />
		<connect from_node="bg_mix" from_socket="closure" to_node="output" to_socket="surface" />
	</shader>
	<shader name="default_empty" />

	<shader name="vol_shader">
		<attribute name="f_attr_T"><socket name="attribute" value="T" type_name="string" /></attribute>
		<attribute name="f_attr_b"><socket name="attribute" value="b" type_name="string" /></attribute>
		<map_range name="f_mr_T">
			<socket name="from_min" value="700.0" type_name="float" />
			<socket name="from_max" value="2100.0" type_name="float" />
			<socket name="clamp" value="true" type_name="boolean" />
		</map_range>
		<map_range name="f_mr_mask">
			<socket name="from_min" value="950.0" type_name="float" />
			<socket name="from_max" value="1250.0" type_name="float" />
			<socket name="clamp" value="true" type_name="boolean" />
		</map_range>
		<rgb_ramp name="f_ramp_T">
			<socket name="ramp" value="0" type_name="array_color" />
			<socket name="ramp_alpha" value="4120" type_name="array_float" />
		</rgb_ramp>
		<rgb_ramp name="f_ramp_b">
			<socket name="ramp" value="0" type_name="array_color" />
			<socket name="ramp_alpha" value="5156" type_name="array_float" />
		</rgb_ramp>
		<math name="f_front"><socket name="math_type" value="multiply" type_name="enum" /></math>
		<math name="f_glow"><socket name="math_type" value="multiply" type_name="enum" />
			<socket name="value2" value="0.01" type_name="float" /></math>
		<math name="f_w"><socket name="math_type" value="multiply_add" type_name="enum" />
			<socket name="value2" value="1.0" type_name="float" /></math>
		<math name="f_emis"><socket name="math_type" value="multiply" type_name="enum" />
			<socket name="value2" value="100.0" type_name="float" /></math>
		<math name="f_dens"><socket name="math_type" value="multiply" type_name="enum" />
			<socket name="value2" value="0.15" type_name="float" /></math>
		<principled_volume name="f_pv">
			<socket name="color" value="0 0 0 0" type_name="color" />
			<socket name="absorption_color" value="0.05 0.25 0.6 0" type_name="color" />
		</principled_volume>
		<connect from_node="f_attr_T" from_socket="fac" to_node="f_mr_T" to_socket="value" />
		<connect from_node="f_attr_T" from_socket="fac" to_node="f_mr_mask" to_socket="value" />
		<connect from_node="f_mr_T" from_socket="result" to_node="f_ramp_T" to_socket="fac" />
		<connect from_node="f_attr_b" from_socket="fac" to_node="f_ramp_b" to_socket="fac" />
		<connect from_node="f_ramp_b" from_socket="alpha" to_node="f_front" to_socket="value1" />
		<connect from_node="f_mr_mask" from_socket="result" to_node="f_front" to_socket="value2" />
		<connect from_node="f_ramp_T" from_socket="alpha" to_node="f_glow" to_socket="value1" />
		<connect from_node="f_front" from_socket="value" to_node="f_w" to_socket="value1" />
		<connect from_node="f_glow" from_socket="value" to_node="f_w" to_socket="value3" />
		<connect from_node="f_w" from_socket="value" to_node="f_emis" to_socket="value1" />
		<connect from_node="f_w" from_socket="value" to_node="f_dens" to_socket="value1" />
		<connect from_node="f_emis" from_socket="value" to_node="f_pv" to_socket="emission_strength" />
		<connect from_node="f_dens" from_socket="value" to_node="f_pv" to_socket="density" />
		<connect from_node="f_ramp_T" from_socket="color" to_node="f_pv" to_socket="emission_color" />
		<connect from_node="f_pv" from_socket="volume" to_node="output" to_socket="volume" />
	</shader>

	<shader name="mat_ceramic">
		<principled_bsdf name="bsdf">
			<socket name="base_color" value="0.16 0.15 0.14 0" type_name="color" />
			<socket name="roughness" value="0.55" type_name="float" />
			<socket name="metallic" value="0.0" type_name="float" />
		</principled_bsdf>
		<connect from_node="bsdf" from_socket="BSDF" to_node="output" to_socket="surface" />
	</shader>
	<shader name="mat_metal">
		<principled_bsdf name="bsdf">
			<socket name="base_color" value="0.55 0.56 0.58 0" type_name="color" />
			<socket name="roughness" value="0.32" type_name="float" />
			<socket name="metallic" value="1.0" type_name="float" />
		</principled_bsdf>
		<connect from_node="bsdf" from_socket="BSDF" to_node="output" to_socket="surface" />
	</shader>
	<shader name="mat_window">
		<transparent_bsdf name="tr">
			<socket name="color" value="1 1 1 0" type_name="color" />
		</transparent_bsdf>
		<glossy_bsdf name="gl">
			<socket name="color" value="0.9 0.95 1 0" type_name="color" />
			<socket name="roughness" value="0.05" type_name="float" />
		</glossy_bsdf>
		<mix_closure name="mix">
			<socket name="fac" value="0.06" type_name="float" />
		</mix_closure>
		<connect from_node="tr" from_socket="BSDF" to_node="mix" to_socket="closure1" />
		<connect from_node="gl" from_socket="BSDF" to_node="mix" to_socket="closure2" />
		<connect from_node="mix" from_socket="closure" to_node="output" to_socket="surface" />
	</shader>

	<mesh name="walls" geometry_type="0">
		<socket name="used_shaders" value="mat_ceramic mat_metal mat_window" type_name="array_node" />
		<socket name="triangles" value="3178588" type_name="array_int" />
		<socket name="shader" value="4234356" type_name="array_int" />
		<socket name="smooth" value="4586284" type_name="array_boolean" />
		<attribute name="P" std="ATTR_STD_POSITION" type="point" element="ATTR_ELEMENT_VERTEX" flags="0" size="263936" buffer="11348" />
	</mesh>
	<object name="walls_object">
		<socket name="geometry" value="walls" type_name="node" />
		<socket name="tfm" value="18.96097 0 0 -4.740242 0 18.96097 0 -0 0 0 18.96097 -0" type_name="transform" />
	</object>

	<camera name="camera">
		<socket name="matrix" value="0.8660254 -0.1545085 -0.4755283 4.631885 0 0.9510565 -0.309017 3.040755 -0.5 -0.2676166 -0.8236391 8.433176" type_name="transform" />
		<socket name="fov" value="0.5235988" type_name="float" />
		<socket name="nearclip" value="0.01" type_name="float" />
		<socket name="farclip" value="1000" type_name="float" />
